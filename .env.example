# Get these from your Supabase project: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key — SERVER ONLY. Never expose to the browser or commit it.
# Used by scripts/seed-demo.ts and app/(app)/settings/actions.ts (user management).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# n8n Chat Trigger webhook (production URL, not /webhook-test/...) for the
# "Helpinho" assistant. SERVER ONLY — used by app/api/assistente/route.ts.
N8N_ASSISTENTE_WEBHOOK_URL=https://n8n.helpmultas.com/webhook/xxxxxxxx
