# Get these from your Supabase project: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key — SERVER ONLY. Never expose to the browser or commit it.
# Used by scripts/seed-demo.ts and app/(app)/settings/actions.ts (user management).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# n8n Chat Trigger webhook (production URL, not /webhook-test/...) for the
# "Helpinho" assistant. SERVER ONLY — used by app/api/assistente/route.ts.
N8N_ASSISTENTE_WEBHOOK_URL=https://n8n.helpmultas.com/webhook/xxxxxxxx

# Shared secret checked on POST /api/social/followers — the n8n workflow
# that polls the Instagram Graph API sends this as "Authorization: Bearer
# <token>". Generate any long random string; put the same value in the
# n8n HTTP Request node's headers.
SOCIAL_INGEST_TOKEN=

# Meta Marketing API (read-only Ads Manager sync). Ad account id in
# "act_XXXXXXXXXXX" format, and a System User access token scoped to
# ads_read. SERVER ONLY — used by app/api/meta-ads/sync/route.ts.
META_AD_ACCOUNT_ID=act_xxxxxxxxxxx
META_SYSTEM_USER_TOKEN=

# Shared secret checked on GET /api/meta-ads/sync (called by Vercel Cron,
# or manually to test). Named CRON_SECRET on purpose — Vercel recognizes
# this exact name and automatically sends it as "Authorization: Bearer
# <value>" on requests it makes to the crons defined in vercel.json.
# Generate any long random string and set the same value in Vercel's
# project env vars.
CRON_SECRET=

# Shared secret checked on POST /api/leads — the landing page sends this as
# "Authorization: Bearer <token>" alongside its normal call to the CRM, so
# every lead also lands here matched against the Meta campaign/adset/ad
# that generated it (via UTMs). Generate any long random string.
LEADS_INGEST_TOKEN=
